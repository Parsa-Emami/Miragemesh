    "/incidents": {
      "get": {
        "summary": "Replay local source-backed incident findings",
        "operationId": "miragemesh_get_local_incidents",
        "tags": [
          "MirageMesh"
        ],
        "security": [],
        "description": "C22 opt-in single-host loopback view. Reads exact immutable segment frames and C05 triage history. Requires explicit local storage, segment limits and operator rate policy. At most 256 indexed events and 1 MiB response; exceeding either returns unavailable without truncating or deleting evidence. Missing coverage and unprojected events remain explicit. No event admission or remote authenticated management API.",
        "responses": {
          "200": {
            "description": "Verified local source trace and durable triage history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalIncidentSnapshot"
                }
              }
            }
          },
          "403": {
            "description": "forbidden_origin",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "const": "forbidden_origin"
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "method_not_allowed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "const": "method_not_allowed"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "incidents_unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "const": "incidents_unavailable"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
