        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "security": [],
        "description": "C22 opt-in loopback mutation. Requires same HTTP Origin and Host/listener port, application/json and Idempotency-Key. The ID must name a finding derived from the currently available segment sources. Body remains exactly the C20 status/reason contract. A retry with the same key and body returns its original durable result; conflict is explicit. Not a remote or multi-user authenticated surface."
      }
