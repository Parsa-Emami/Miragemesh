  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque/OIDC-access-token"
      },
      "mutualTLS": {
        "type": "mutualTLS"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "description": "Unique command key. Same key + same principal + same semantic request must replay the original result."
      },
      "RequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      }
    },
    "schemas": {
      "OperationResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "status"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "operation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "resource_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "status": {
            "type": "string"
          },
          "data": {
            "type": [
              "object",
              "array",
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "code",
          "message"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "details": {
            "type": [
              "object",
              "array",
              "null"
            ]
          }
        }
      },
      "LocalSourceRef": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sensor_id",
          "event_id",
          "sequence",
          "segment",
          "record",
          "digest"
        ],
        "properties": {
          "sensor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "segment": {
            "type": "string",
            "pattern": "^segment-[0-9]{20}$"
          },
          "record": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "LocalReplayEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "sensor_id",
          "event_id",
          "sequence",
          "observed_at",
          "kind",
          "metadata"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1"
          },
          "sensor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
          },
          "kind": {
            "type": "string",
            "const": "http.request"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "LocalTriageLabel": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "reason",
          "triaged_at"
        ],
        "properties": {
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "triaged_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LocalIncidentSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "coverage",
          "unprojected_events",
          "rate_limit",
          "window_seconds",
          "incidents"
        ],
        "properties": {
          "schema_version": {
            "const": "1",
            "type": "string"
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "complete",
              "missing_ordinals",
              "incomplete_segments"
            ],
            "properties": {
              "complete": {
                "type": "boolean"
              },
              "missing_ordinals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "after",
                    "before"
                  ],
                  "properties": {
                    "after": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "before": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  }
                }
              },
              "incomplete_segments": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "retention_gaps": {
                "type": "array",
                "maxItems": 16384,
                "items": {
                  "$ref": "#/components/schemas/RetentionSummary"
                }
              }
            }
          },
          "unprojected_events": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rate_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "window_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "incidents": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "finding",
                "events",
                "history"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^incident-[a-f0-9]{64}$"
                },
                "finding": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "class",
                    "sensor_id",
                    "explanation",
                    "sources"
                  ],
                  "properties": {
                    "class": {
                      "type": "string",
                      "enum": [
                        "interaction",
                        "attack_signal"
                      ]
                    },
                    "sensor_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "explanation": {
                      "type": "string"
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LocalSourceRef"
                      },
                      "minItems": 1,
                      "maxItems": 256
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "window_seconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "observed_from": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "observed_to": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                "events": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source",
                      "event"
                    ],
                    "properties": {
                      "source": {
                        "$ref": "#/components/schemas/LocalSourceRef"
                      },
                      "event": {
                        "$ref": "#/components/schemas/LocalReplayEvent"
                      }
                    }
                  },
                  "minItems": 1,
                  "maxItems": 256
                },
                "history": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LocalTriageLabel"
                  }
                }
              }
            },
            "maxItems": 512
          },
          "retained_events": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "RetentionSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment",
          "records",
          "bytes",
          "digest",
          "before",
          "expired_at",
          "reason"
        ],
        "properties": {
          "segment": {
            "type": "string",
            "pattern": "^segment-[0-9]{20}$",
            "not": {
              "const": "segment-00000000000000000000"
            }
          },
          "records": {
            "type": "integer",
            "minimum": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "before": {
            "type": "string",
            "format": "date-time"
          },
          "expired_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "responses": {
      "ErrorResponse": {
        "description": "Stable API error envelope.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    }
  }
}
