        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
