{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:parsa:miragemesh:input:1",
  "title": "MirageMesh v1 local HTTP event validation input",
  "$comment": "The Go decoder additionally enforces <=8192 UTF-8 input bytes, no duplicate keys or trailing data, and exact numeric values; validation is not authentication, persistence or collector acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sensor_id",
    "event_id",
    "sequence",
    "observed_at",
    "kind",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "sensor_id": {
      "$ref": "#/$defs/identifier"
    },
    "event_id": {
      "$ref": "#/$defs/identifier"
    },
    "sequence": {
      "$ref": "#/$defs/sequence"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "kind": {
      "type": "string",
      "const": "http.request"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
