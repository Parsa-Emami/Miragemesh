[Unit]
Description=MirageMesh web application shell
After=network.target

[Service]
Type=simple
User=miragemesh-web
Group=miragemesh-web
WorkingDirectory=/srv/miragemesh/current
ExecStart=/usr/bin/node scripts/serve-web.mjs --root web --port 4307 --config ops/web/runtime-config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
