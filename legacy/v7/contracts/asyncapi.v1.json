    },
    "schemas": {
      "EventEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "specversion",
          "id",
          "source",
          "type",
          "time",
          "subject",
          "data"
        ],
        "properties": {
          "specversion": {
            "type": "string",
            "const": "1.0"
          },
          "id": {
            "type": "string",
            "minLength": 16
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "sensor.enrolled.v1",
              "sensor.heartbeat.v1",
              "desired_state.published.v1",
              "applied_state.reported.v1",
              "decoy.interaction_observed.v1",
              "incident.correlated.v1",
              "sensor.spool_pressure.v1"
            ]
          },
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "subject": {
            "type": "string"
          },
          "traceparent": {
            "type": [
              "string",
              "null"
            ]
          },
          "datacontenttype": {
            "type": "string",
            "const": "application/json"
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
