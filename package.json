{
  "name": "@parsa-emami/miragemesh-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "MirageMesh web application foundation",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "prepare:web": "node scripts/generate-web-data.mjs",
    "dev": "npm run prepare:web && vite --config apps/web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run prepare:web && npm run typecheck && vite build --config apps/web/vite.config.ts && npm run build:engine",
    "start": "node scripts/start-local.mjs",
    "test": "node --test tests/web/*.test.mjs tests/contracts/*.test.mjs tests/engineering/*.test.mjs tests/release/*.mjs",
    "test:browser": "playwright test",
    "package": "bash scripts/package.sh",
    "package:web": "node scripts/package-web.mjs",
    "package:source": "node scripts/package-source.mjs",
    "verify:artifact": "node scripts/verify-artifact.mjs dist/release",
    "verify:release": "node scripts/verify-release.mjs",
    "sign:release": "node scripts/sign-release.mjs",
    "install:release": "node scripts/install-release.mjs",
    "test:release": "node --test tests/release/*.mjs",
    "validate:plan": "node scripts/roadmap.mjs validate",
    "check": "npm run validate:plan && npm run build && npm test",
    "setup": "node scripts/oss-bootstrap.mjs setup",
    "doctor": "node scripts/oss-bootstrap.mjs doctor",
    "plan": "node scripts/roadmap.mjs",
    "release:check": "node scripts/roadmap.mjs release-check",
    "test:clone": "node scripts/clone-smoke.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "test:contracts": "node scripts/build-engine.mjs && node --test tests/contracts/*.test.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
